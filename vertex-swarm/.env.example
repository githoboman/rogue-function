# WoG Agent Swarm — Environment
# Copy to vertex-swarm/.env and fill in. .env is gitignored.

# ── SigNoz / OpenTelemetry ──────────────────────────────────
# From SigNoz Cloud → Settings → Ingestion Settings.
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us2.signoz.cloud:443
SIGNOZ_INGESTION_KEY=your-signoz-ingestion-key
OTEL_SERVICE_NAME=wog-agent-swarm

# ── FoxMQ broker ────────────────────────────────────────────
FOXMQ_HOST=localhost
FOXMQ_PORT=1883

# ── Self-heal webhook (SigNoz alert receiver) ───────────────
SELFHEAL_PORT=8099
